{
  "name": "alphatech_backend",
  "version": "1.0.0",
  "description": "Backend API for AlphaaTechh PC Parts, Custom 3D Builder, Razorpay, MSG91, and Admin Panel",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "prisma generate && tsc && npm run enrichProduct",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "ts-node src/scripts/seedFromExcel.ts",
    "ingest": "ts-node src/scripts/ingestExcel.ts",
    "map-images": "ts-node src/scripts/mapImagesToProducts.ts",
    "enrichProduct":"ts-node src/scripts/enrichProductMetadata.ts"

  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.16.0",
    "razorpay": "^2.9.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "nodemon": "^3.1.9",
    "prisma": "^6.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
